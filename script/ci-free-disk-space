#!/usr/bin/env bash

# Removes preinstalled toolchains this project does not use from a GitHub-hosted Linux runner.
# The runner starts with about 14 GB free, which a workspace build exceeds.

set -euo pipefail

if [[ -z "${GITHUB_ACTIONS:-}" ]]; then
    echo "This script deletes system directories and only runs on GitHub Actions runners." >&2
    exit 1
fi

df -h /
sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL /usr/local/share/boost /usr/share/swift
sudo docker image prune --all --force >/dev/null 2>&1 || true
df -h /
