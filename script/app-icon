#!/bin/sh
# Rebuilds the app's icons from their drawings in crates/zed/resources/app-icon, after a drawing
# changes: kurocto.svg (and its -dev, -nightly and -preview variants), kurocto-small.svg for
# 64 pixels and under, and document.svg for the document icon.
#
#   script/app-icon
#
# The rendered icons are checked in, so the bundle scripts need neither this nor a renderer. Needs
# Xcode's command line tools (swift, iconutil) and, for the Windows .ico files, Python with Pillow.
set -eu

cd "$(dirname "$0")/../crates/zed/resources"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

cat > "$TMP/render.swift" <<'EOF'
import AppKit
let a = CommandLine.arguments
guard let img = NSImage(contentsOfFile: a[1]), let n = Int(a[3]) else { fatalError("usage: render in.svg out.png pixels") }
let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: n, pixelsHigh: n, bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
rep.size = NSSize(width: n, height: n)
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
NSGraphicsContext.current!.imageInterpolation = .high
img.draw(in: NSRect(x: 0, y: 0, width: n, height: n), from: .zero, operation: .copy, fraction: 1)
NSGraphicsContext.restoreGraphicsState()
try! rep.representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: a[2]))
EOF
swiftc -O -o "$TMP/render" "$TMP/render.swift"

# The whole name cannot be read in 64 pixels: the name from 128 up, its k under that.
drawing_for() {
    if [ "$2" -le 64 ]; then echo "app-icon/kurocto-small.svg"; else echo "app-icon/kurocto$1.svg"; fi
}

for channel in "" -dev -nightly -preview; do
    "$TMP/render" "app-icon/kurocto$channel.svg" "app-icon$channel.png" 512
    "$TMP/render" "app-icon/kurocto$channel.svg" "app-icon$channel@2x.png" 1024

    # macOS takes the name from 128 pixels up and the k under that, so the .icns is built here
    # instead of letting the bundler scale the name down.
    SET="$TMP/app-icon$channel.iconset"
    mkdir "$SET"
    for n in 16 32 128 256 512; do
        "$TMP/render" "$(drawing_for "$channel" "$n")" "$SET/icon_${n}x${n}.png" "$n"
        "$TMP/render" "$(drawing_for "$channel" $((n * 2)))" "$SET/icon_${n}x${n}@2x.png" $((n * 2))
    done
    iconutil -c icns "$SET" -o "app-icon$channel.icns"

    ICO="$TMP/ico$channel"
    mkdir "$ICO"
    for n in 16 32 64 128 256; do
        "$TMP/render" "$(drawing_for "$channel" "$n")" "$ICO/$n.png" "$n"
    done
    python3 - "$ICO" "windows/app-icon$channel.ico" <<'EOF'
import sys
from PIL import Image

directory, output = sys.argv[1], sys.argv[2]
sizes = [16, 32, 64, 128, 256]
images = [Image.open(f"{directory}/{size}.png") for size in sizes]
images[-1].save(output, format="ICO", append_images=images[:-1], sizes=[(size, size) for size in sizes])
EOF
done

DOCUMENT_SET="$TMP/Document.iconset"
mkdir "$DOCUMENT_SET"
for n in 16 32 128 256 512; do
    "$TMP/render" app-icon/document.svg "$DOCUMENT_SET/icon_${n}x${n}.png" "$n"
    "$TMP/render" app-icon/document.svg "$DOCUMENT_SET/icon_${n}x${n}@2x.png" $((n * 2))
done
iconutil -c icns "$DOCUMENT_SET" -o Document.icns

# A look at what was drawn, when asked for: PREVIEW=/some/dir script/app-icon
if [ -n "${PREVIEW-}" ]; then
    cp app-icon*.png "$PREVIEW/"
    cp "$DOCUMENT_SET"/icon_512x512.png "$PREVIEW/document.png"
    for channel in "" -dev -nightly -preview; do
        cp "$TMP/ico$channel/32.png" "$PREVIEW/small$channel-32.png"
    done
fi
echo "wrote icons in $(pwd)"
